# Copy to .env and fill in. Restart the app after any change.

# TypeSafe AI API key (Jev model), read by typesafe-sdk
TYPESAFE_API_KEY=

# Azure app registration (see README, "Connecting to Outlook")
MS_CLIENT_ID=
# consumers = personal Outlook/Hotmail account; organizations = work/school account; common = both
MS_TENANT=common

# --- Optional (defaults shown) ---
# OUTLOOK_FOLDER=inbox            # "all" = every folder
# NEWSLETTER_FOLDER=Newsletter    # existing Outlook folder where recent newsletters are filed
# FLAG_UNCERTAIN_REPLIES=1        # also flag uncertain "awaiting reply" mails
# JEV_MODEL=jev-latest
# JEV_CONCURRENCY=20
# CONFIDENCE_THRESHOLD=0.8
# INJECTION_THRESHOLD=0.5
# BODY_MAX_CHARS=2000             # body characters sent to Jev
# PRICE_PER_MTOK=0.042            # $ per million tokens, for the cost estimate
# MAIL_DB=data/mail.db
# PREFERENCES_FILE=preferences.json
# TOKEN_CACHE_FILE=token_cache.json
# ALLOWED_HOSTS=127.0.0.1,localhost,::1
